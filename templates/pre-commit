#!/bin/sh
# Salla Theme Review — pre-commit gate
# Generated by the Salla Theme Reviewer VS Code extension ("Setup Git & CI Checks").
# Fast local check (~0.5s): no network, no parity, no report files.
# Errors (documented Salla rejection reasons) block the commit; warnings do not.
#
# Bypass once:      git commit --no-verify
# Bypass via env:   SALLA_REVIEW_SKIP=1 git commit ...

[ "$SALLA_REVIEW_SKIP" = "1" ] && exit 0

node "{{THEME_DIR}}/.salla-review/cli.js" "{{THEME_DIR}}" \
  --no-report --no-network --no-parity --fail-on {{FAIL_ON}}
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "⛔ Salla Review found blocking errors. Fix them, or bypass once with: git commit --no-verify"
fi
exit $status
