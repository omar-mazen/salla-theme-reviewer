#!/bin/sh
# Salla Theme Review — pre-push gate
# Generated by the Salla Theme Reviewer VS Code extension ("Setup Git & CI Checks").
# Full check including the Twilight package version check (needs network; skipped
# silently when offline). Errors block the push; warnings do not.
#
# Bypass once:      git push --no-verify
# Bypass via env:   SALLA_REVIEW_SKIP=1 git push ...

[ "$SALLA_REVIEW_SKIP" = "1" ] && exit 0

node "{{THEME_DIR}}/.salla-review/cli.js" "{{THEME_DIR}}" \
  --no-report --no-parity --fail-on {{FAIL_ON}}
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "⛔ Salla Review found blocking errors. Fix them, or bypass once with: git push --no-verify"
fi
exit $status
